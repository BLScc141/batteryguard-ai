# Versión de Python usada en despliegue (Render) y desarrollo local
PYTHON_VERSION=3.13.14

# Base de datos:
# - Si se deja vacío en local, usa SQLite automáticamente (batteryguard.db).
# - En producción (Render + Supabase), usar la URL del Session Pooler (puerto 5432).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Clave secreta para firmar tokens JWT (HS256)
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRE_HOURS=24

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=https://batteryguard-ai-front.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Credenciales del administrador inicial (seed automático en BD vacía)
ADMIN_EMAIL=admin@batteryguard.ai
ADMIN_PASSWORD=admin1234
